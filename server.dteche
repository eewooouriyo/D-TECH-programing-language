<type:dtech:executable>
// DISCLAIMER: this is only a test its NOT the final version of servers
// AVISO: esto solo es una prueba esta NO es la version final de los servidores
// D-TECH Server Example
// Ejemplo de servidor en D-TECH

@command.console.all.==true
@command.console.log.file=="server".log

// Start server on port 3000 with max 10 simultaneous connections
// Inicia servidor en puerto 3000 con máximo 10 conexiones simultáneas
@command.start.server.port."3000".max.joins=="10"

print("D-TECH Server initialized successfully!")
print("Listening on port 3000")
print("Max connections: 10")
print("Interactive console active - use SUDO@SERVER-:=> to control requests")
